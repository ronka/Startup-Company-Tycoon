# nativewind@5 preview and other Expo/RN prereleases don't satisfy some
# packages' semver peer ranges (e.g. @legendapp/motion wants nativewind >=4.0.0,
# which npm's strict semver rejects for a 5.0.0-preview build). pnpm resolved
# these leniently; this keeps npm + EAS installs working the same way.
legacy-peer-deps=true
